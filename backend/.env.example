# Copiez ce fichier en .env et remplissez vos vraies valeurs (ne commitez JAMAIS .env)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/taskmanager_db"
PORT=3001
# URL du frontend autorisée par CORS (en production : l'URL Vercel/Netlify)
CORS_ORIGIN="http://localhost:5173"

# Secret de signature des JWT (32+ caractères aléatoires). Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="remplacez-moi-par-une-longue-valeur-aleatoire"
JWT_EXPIRES_IN="7d"
